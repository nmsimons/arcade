# Public OAuth client IDs, never client secrets. Copy to .env.local for development.
# Google: Web application client with this site's exact Authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=
# Optional Google file picker: browser API key and project number from that same project.
# Enable Google Picker API. Restrict the key to Picker/Drive APIs and the site + docs.google.com referrers.
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=
# Microsoft: personal accounts, Single-page application redirect to /auth-redirect.html.
VITE_MICROSOFT_CLIENT_ID=
