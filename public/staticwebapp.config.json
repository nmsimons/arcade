{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/levels/*",
      "/*.css",
      "/*.js",
      "/*.mjs",
      "/*.map",
      "/*.json",
      "/*.svg",
      "/*.ico",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.webp",
      "/*.wasm"
    ]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".css": "text/css",
    ".wasm": "application/wasm",
    ".svg": "image/svg+xml"
  },
  "routes": [
    {
      "route": "/levels/jumping/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ]
}
